{
	"name": "echo-notes",
	"version": "0.4.9",
	"description": "Echo Notes Obsidian plugin MVP",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "npm run lint:base && npm run lint:obsidian",
		"lint:base": "eslint .",
		"lint:obsidian": "eslint --max-warnings=0 --config eslint.obsidian.config.mjs \"src/**/*.ts\"",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "npm run typecheck && node esbuild.config.mjs production && node scripts/verify-runtime-bundle.mjs",
		"verify:settings-ui": "npm run build && node scripts/verify-settings-ui.mjs",
		"verify:real-chain": "npm run build && node scripts/real-chain-validation.mjs",
		"verify": "node scripts/run-verification.mjs",
		"package": "npm run verify && node scripts/package-release.mjs",
		"test": "node scripts/run-tests.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"audio",
		"transcription"
	],
	"author": "anbang278",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.1",
		"@types/ws": "8.18.1",
		"esbuild": "^0.25.5",
		"eslint": "^10.7.0",
		"eslint-plugin-obsidianmd": "0.4.1",
		"obsidian": "^1.13.1",
		"playwright-core": "^1.57.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.63.0"
	},
	"dependencies": {
		"ws": "8.21.1"
	}
}
