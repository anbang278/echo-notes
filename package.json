{
	"name": "echo-notes",
	"version": "0.2.28",
	"description": "Echo Notes Obsidian plugin MVP",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"package": "npm run build && node scripts/package-release.mjs",
		"test": "node scripts/run-tests.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"audio",
		"transcription"
	],
	"author": "anbang278",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.15.30",
		"esbuild": "^0.25.5",
		"eslint": "^10.4.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.60.1"
	}
}
